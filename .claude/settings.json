{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npm run --silent corpus:check 1>&2 || exit 2",
            "if": "Edit(content/**)",
            "timeout": 120,
            "statusMessage": "Checking the corpus…"
          },
          {
            "type": "command",
            "command": "npm run --silent corpus:check 1>&2 || exit 2",
            "if": "Write(content/**)",
            "timeout": 120,
            "statusMessage": "Checking the corpus…"
          }
        ]
      }
    ]
  }
}
