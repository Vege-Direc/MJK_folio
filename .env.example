# One OpenRouter API key. Rate limits are per ACCOUNT (20 rpm; 50/day, or 1000/day past
# $10 of credit), so a second key buys nothing -- both would draw on the same budget.
OPENROUTER_API_KEY=

# Redis. Backs the admission-control limiters in lib/security/limits.ts. Optional --
# absent in dev and in tests, where the limiters fall back to in-process memory.
REDIS_URL=redis://redis:6379

# The shared daily ceiling on /api/ask, across every visitor. OpenRouter caps the whole
# account at 1000 requests/day; this keeps the site under that with headroom for the
# rest of the day even after one visitor exhausts their own per-IP limit. See the
# "Limits" section in coolify.md.
ASK_DAILY_BUDGET=800

# Disable Next.js telemetry in prod
NEXT_TELEMETRY_DISABLED=1

# The public https origin the site is served from — used for metadata, Open Graph
# URLs, JSON-LD and the sitemap. In production this MUST be the real public https
# origin (e.g. https://mathewjohnk.com), not localhost, or shared links and search
# results point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://mjk.nila.li

# The instrument (DIRECTION.md decision 11). A shared secret that unlocks GET
# /api/instrument, the private plain-text aggregate of what the site already counts:
# page views, asks, the card/chip/typed split, the stop each answer landed in, and what
# the guard did with it. UNSET IS OFF -- with no value here the route answers 404 to
# everyone, including the owner, and that is both the default and the rollback. Generate
# one with `openssl rand -hex 32`. Never share the URL with the key in it.
INSTRUMENT_TOKEN=
