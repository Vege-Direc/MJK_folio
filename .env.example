# Comma-separated OpenRouter API keys — rotated on rate-limit
OPENROUTER_KEYS=

# Model to use via OpenRouter (default: free/cheap models we rotate through)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Redis (rate-limit counters + key cooldowns). Coolify-managed one-click Redis.
REDIS_URL=redis://redis:6379

# Disable Next.js telemetry in prod
NEXT_TELEMETRY_DISABLED=1
