# One OpenRouter API key. Rate limits are per ACCOUNT (20 rpm; 50/day, or 1000/day past
# $10 of credit), so a second key buys nothing -- both would draw on the same budget.
OPENROUTER_API_KEY=

# Redis. Reserved for rate-limit state; nothing reads it yet.
REDIS_URL=redis://redis:6379

# Disable Next.js telemetry in prod
NEXT_TELEMETRY_DISABLED=1
